# Only needed for the run_agent_with_external_model tool — the six prompt-based
# agents work with zero configuration using whatever model your MCP client (e.g.
# Claude Desktop) already provides.
#
# Never commit a real .env file. Copy this to .env for local testing only, or set
# these directly in your MCP client's server config `env` block.

# Required for run_agent_with_external_model:
AQUA_API_KEY=

# Optional — defaults to https://api.openai.com/v1. Point this at any other
# OpenAI-compatible endpoint (local Ollama/LM Studio, another provider, etc.).
AQUA_BASE_URL=https://api.openai.com/v1

# Required for run_agent_with_external_model unless passed explicitly per call.
AQUA_MODEL=
